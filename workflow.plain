command: list the folder, uses, list, the folder

[file], is, in the folder
    if [command], uses, list, the folder
    and [command], returned, file, [file]

[command], uses, count lines, [file]
    if [file], is, in the folder
    and [command], is the join of, "command: count the lines of ", [file]

[file], has lines, [count]
    if [command], uses, count lines, [file]
    and [command], returned, lines, [count]

[command], uses, [tool], [file]
    if [file], written in, [language]
    and [tool], finds comments in, [language]
    and [command], is the join of, "command: find the comments in ", [file]

[file], has the comment, [text]
    if [command], uses, [tool], [file]
    and [tool], finds comments in, [any language]
    and [command], returned, comment, [text]

[command], uses, parse, [file]
    if [anyone], loads, [file]
    and [file], is, in the folder
    and [command], is the join of, "command: parse ", [file]

[rule], is in, [file]
    if [command], uses, parse, [file]
    and [command], returned, rule, [rule]

[command], uses, read a rule, [rule]
    if [rule], is in, [any file]
    and [command], is the join of, "command: read the rule ", [rule]

[rule], defines, [word]
    if [command], uses, read a rule, [rule]
    and [command], returned, word it defines, [word]

[rule], refers to, [word]
    if [command], uses, read a rule, [rule]
    and [command], returned, word it refers to, [word]

[rule], lays down, [law]
    if [command], uses, read a rule, [rule]
    and [command], returned, law it lays down, [law]

[pattern], is, a pattern
    if [anyone], creates fact, [pattern]
[pattern], is, a pattern
    if [anyone], executes instruction, [pattern]
[pattern], is, a pattern
    if [anyone], prints, [pattern]

[command], uses, read a fact pattern, [pattern]
    if [pattern], is, a pattern
    and [command], is the join of, "command: read the pattern ", [pattern]

[pattern], names, [word]
    if [command], uses, read a fact pattern, [pattern]
    and [command], returned, word it names, [word]

[command], uses, try, [change]
    if [change], is, a change
    and not this run is a change
    and [command], is the join of, "command: try ", [change]

[change], broke, [law]
    if [command], uses, try, [change]
    and [command], returned, broke, [law]

[change], answered, [answer]
    if [command], uses, try, [change]
    and [command], returned, exit code, [code]
    and [answer], exits with, [code]

command: see what fired, uses, see what fired, this run

[rule], is, fired in a trial
    if [command], uses, try, [any change]
    and [command], returned, never fired, [any rule]
    and [rule], is in, [any file]
    and not [command], returned, never fired, [rule]

[rule], is, never fired
    if [rule], is in, [any file]
    and [command], uses, see what fired, [any input]
    and not [command], returned, rule that fired, [rule]
    and not [rule], is, fired in a trial
