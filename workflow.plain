command: list the folder, uses, list, the folder
[file], is, in the folder
    if command: list the folder, returned, file, [file]

[command], uses, [tool], [file]
    if [file], written in, [language]
    and [tool], finds comments in, [language]
    and [command], is the join of, "command: find the comments in ", [file]

[file], has the comment, [text]
    if [command], uses, [tool], [file]
    and [tool], finds comments in, [any language]
    and [command], returned, comment, [text]

[command], uses, try, [change]
    if [change], is, a change
    and not this run is a change
    and [command], is the join of, "command: try ", [change]

[change], broke, [law]
    if [command], uses, try, [change]
    and [command], returned, broke, [law]

[change], answered, [answer]
    if [command], uses, try, [change]
    and [command], returned, exit code, [code]
    and [answer], exits with, [code]

[change], explains, [line]
    if [command], uses, try, [change]
    and [command], returned, why, [line]
