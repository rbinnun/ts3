command: list the folder, calls, list, the folder

[file], is, in the folder
    if command: list the folder, returned, file, [file]

[command], calls, find go comments, [file]
    if [file], is, in the folder
    and [file], ends with, .go
    and [command], is the join of, "command: find the comments in ", [file]

[file], has the comment, [comment]
    if [command], calls, find go comments, [file]
    and [command], returned, comment, [comment]

[command], calls, try, [change]
    if [change], is, a change
    and not this run is a change
    and [command], is the join of, "command: try ", [change]

[command], is, named as a command
    if [command], calls, [any tool], [any input]
    and [command], starts with, "command: "

list, is, in the catalog
list, returns, file
find go comments, is, in the catalog
find go comments, returns, comment
try, is, in the catalog
try, returns, broke
try, returns, exit code
try, returns, explanation

[file], is, a used file
    if [any go file], loads, [file]
[file], is, a used file
    if [any level], is tested with, [file]
[file], is, a used file
    if [file], creates fact, [any fact pattern]
kernel/go.mod, is, a used file
kernel/go.sum, is, a used file
kernel/runme.sh, is, a used file

[file], is, known
    if [file], is, in the folder
    and [ending], means, [any language]
    and [file], ends with, [ending]

[predicate], is, a predicate
    if [any rule], defines, [predicate]
[predicate], is, a used predicate
    if [any rule], refers to, [predicate]
[predicate], is, a used predicate
    if the knowledge, shows, [fact pattern]
    and [fact pattern], names, [predicate]

ending, is, a slot name
language, is, a slot name
code, is, a slot name

[slot], is, a slot
    if [any fact pattern], has the slot, [slot]
[slot], is, a slot
    if [slot], is, a slot name
[blank], is, well named
    if [blank], is, a slot
[blank], is, well named
    if [any rule], has the blank, [blank]
    and [slot], is, a slot
    and [blank], is the join of, "any ", [slot]
[blank], is, well named
    if [any rule], has the blank, [blank]
    and [slot], is, a slot
    and [blank], is the join of, "other ", [slot]
