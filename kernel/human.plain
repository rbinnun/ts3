    if [command], calls, try, [change]
    and [command], returned, broke, [law]
[change], answered, [answer]
    if [command], calls, try, [change]
    and [command], returned, exit code, [code]
    and [answer], exits with, [code]
[change], explains, [explanation]
    if [command], calls, try, [change]
    and [command], returned, explanation, [explanation]
[law], is, a law
    if [any rule], lays down, [law]
[law], is, a law with a counterexample
    if [change], broke, [law]
    and [change], explains, [any explanation]
[law], is, a law with a counterexample
    if this run is a change
    and [any change], must break, [law]
[law], is, a law with a counterexample
    if [rule], lays down, [law]
    and [rule], is in the file, [file]
    and [file], is, certified

[law], breaks, Every law has a counterexample
    if [law], is, a law
    and not [law], is, a law with a counterexample
[change], breaks, Every change comes out as stated
    if [change], must break, [law]
    and not this run is a change
    and not [change], broke, [law]
[change], breaks, Every change comes out as stated
    if [change], must answer, [answer]
    and not this run is a change
    and not [change], answered, [answer]
[change], breaks, Every change comes out as stated
    if [change], must explain, [explanation]
    and not this run is a change
    and not [change], explains, [explanation]
[change], breaks, Every change comes out as stated
    if [change], must break, [law]
    and not [law], is, a law

a law with no counterexample, adds line, kernel/agent.plain, "something, breaks, A law with no counterexample"
a law with no counterexample, must break, Every law has a counterexample

a change that expects an unknown law, adds line, kernel/agent.plain, "a ghost change, must break, A law nobody laid down"
a change that expects an unknown law, must break, Every change comes out as stated

[predicate], breaks, Every predicate is used
    if [predicate], is, a predicate
    and not [predicate], is, a used predicate

a predicate nobody uses, adds line, kernel/human.plain, "a, is, lonely"
