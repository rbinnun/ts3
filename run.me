#!/bin/sh
# run.me: the entry point universe.mg names. Builds the runner (main.go)
# against the Mangle module and version universe.mg asks for, then runs
# universe.mg with it. Every Go cache stays inside this folder, under .deps.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
deps="$here/.deps"
export GOPATH="$deps/gopath" GOMODCACHE="$deps/gomodcache" GOCACHE="$deps/gocache" \
       XDG_CONFIG_HOME="$deps/config" GOFLAGS=-modcacherw
cd "$here"
go build -o "$deps/bin/universe" .
exec "$deps/bin/universe" -entry "$(basename "$0")" "$here/universe.mg"
