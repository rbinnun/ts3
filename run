#!/bin/sh
root="$(cd "$(dirname "$0")" && pwd)"
if [ "$#" -ne 1 ]; then
	echo "usage: ./run machine_folder" >&2
	exit 64
fi
folder="${XDG_CACHE_HOME:-$HOME/.cache}/ts3/$(printf %s "$root" | cksum | cut -d ' ' -f 1)"
CGO_ENABLED=0 GOFLAGS= GOSUMDB=off go -C "$root/runner" build -buildvcs=false -trimpath -o "$folder/runner" . || exit 70
exec "$folder/runner" "$root/runner/step.mg" "$1"
