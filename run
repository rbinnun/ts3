#!/bin/sh
root="$(cd "$(dirname "$0")" && pwd)"
if [ "$#" -gt 2 ] || { [ "$#" -ge 1 ] && [ ! -d "$1" ]; }; then
	echo "usage: ./run [machine_folder [query]]" >&2
	exit 64
fi
folder="${XDG_CACHE_HOME:-$HOME/.cache}/ts3/$(printf %s "$root" | cksum | cut -d ' ' -f 1)"
CGO_ENABLED=0 GOFLAGS= GOSUMDB=off go -C "$root" build -o "$folder/mg" codeberg.org/TauCeti/mangle-go/interpreter/mg || exit 70
CGO_ENABLED=0 GOFLAGS= GOSUMDB=off go -C "$root" build -o "$folder/read_the_programs" ./real_effects || exit 70

ask() {
	answer="$("$folder/mg" -logtostderr -load "$1" -exec "$2" 2>&1)"
	asked=$?
	printf '%s\n' "$answer" | grep -v -e "^loaded " -e "^$"
	return "$asked"
}

programs_of() {
	programs="$root/effects.mg"
	for program in "$1"/*.mg; do
		programs="$programs,$program"
	done
	printf '%s' "$programs"
}

held_to_expectations() {
	[ -f "$1/expect.mg" ] || return 0
	if ask "$(programs_of "$1")" "expected()" > /dev/null; then
		echo "$(basename "$1"): as expected"
		return 0
	fi
	echo "$(basename "$1"): not as expected"
	return 1
}

"$folder/read_the_programs" "$root" > "$folder/programs.mg" || exit 70
if ! ask "$root/laws.mg,$folder/programs.mg" "kept()" > /dev/null; then
	ask "$root/laws.mg,$folder/programs.mg" "violation(Law, Predicate)" | grep "^violation"
	exit 1
fi
echo "every program keeps the laws"

if [ "$#" -eq 0 ]; then
	failed=0
	for machine in "$root"/machines/*/; do
		held_to_expectations "${machine%/}" || failed=1
	done
	exit "$failed"
fi

machine="$(cd "$1" && pwd)"
ask "$(programs_of "$machine")" "${2:-tells(Line)}"
answered=$?
held_to_expectations "$machine" || exit 1
exit "$answered"
